      "id": "thermal-context",
      "description": "Thermal investigation with unrelated evidence, long hypotheses and a real worker restart.",
      "world": {
        "question": "Why did GPU temperature increase at matched power?",
        "start": "2026-10-01T11:00:00Z",
        "end": "2026-10-01T12:00:00Z",
        "evidence": [
          {
            "id": "z-observation",
            "role": "PRIMARY",
            "summary": "GPU temperature increased from 52 C to 69 C at matched power.",
            "status": "COMPLETE",
            "available_after_action": 0
          },
          {
            "id": "z-detail",
            "role": "DETAIL",
            "summary": "GPU temperature remains 19 C above sibling GPUs at similar power; fans and inlet temperature are normal.",
            "status": "COMPLETE",
            "available_after_action": 1
          },
          {
            "id": "a-noise-1",
            "role": "PRIMARY",
            "summary": "Login activity is unchanged over the recorded period.",
            "status": "COMPLETE",
            "available_after_action": 0
          },
          {
            "id": "a-noise-2",
            "role": "PRIMARY",
            "summary": "Package cache metadata was read successfully.",
            "status": "COMPLETE",
            "available_after_action": 0
          },
          {
            "id": "a-noise-3",
            "role": "PRIMARY",
            "summary": "The terminal configuration has not changed.",
            "status": "COMPLETE",
            "available_after_action": 0
          }
        ]
      },
      "oracle": {
        "required_evidence": [
          "z-observation",
          "z-detail"
        ],
        "expected_outcome": "PARTIAL",
        "minimum_hidden_tests": 4,
        "expect_detection": false
      },
      "detection": {
        "kind": "gpu_thermal",
        "temperature": 69
      }
    },
