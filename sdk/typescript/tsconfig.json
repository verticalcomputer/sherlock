{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true, "outDir": "dist", "rootDir": "src", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitOverride": true, "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts"]
}
