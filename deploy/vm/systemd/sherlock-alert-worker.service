[Unit]
Description=Sherlock GP-09 alert outbox delivery worker
After=network-online.target sherlock-postgres.service
Wants=network-online.target
Requires=sherlock-postgres.service

[Service]
Type=simple
User=sherlock
Group=sherlock
WorkingDirectory=/opt/sherlock/current
EnvironmentFile=/etc/sherlock/common.env
ExecStartPre=/usr/bin/test -x /opt/sherlock/tools/sherlock-alert-worker
ExecStartPre=/usr/bin/test -r /etc/sherlock/alert-secrets/slack-webhook.url
ExecStart=/opt/sherlock/tools/sherlock-alert-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
