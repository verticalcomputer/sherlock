[Unit]
Description=Sherlock private administrator dashboard
Documentation=file:/opt/sherlock/current/deploy/vm/README.md
After=network-online.target sherlock-api.service
Wants=network-online.target
Requires=sherlock-api.service

[Service]
Type=simple
User=sherlock
Group=sherlock
WorkingDirectory=/opt/sherlock/current
EnvironmentFile=/etc/sherlock/admin-ui.env
ExecStartPre=/usr/bin/test -x /opt/sherlock/current/bin/sherlock-admin-ui
ExecStart=/opt/sherlock/current/bin/sherlock-admin-ui
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
