# Copy to /etc/sherlock/postgres-compose.env with mode 0600.
# Pin the production image to a reviewed immutable digest before go-live, for
# example: postgres:17-alpine@sha256:<reviewed-manifest-digest>
SHERLOCK_POSTGRES_IMAGE=postgres:17-alpine
SHERLOCK_POSTGRES_DB=sherlock
SHERLOCK_POSTGRES_USER=sherlock
SHERLOCK_POSTGRES_BIND_ADDRESS=127.0.0.1
SHERLOCK_POSTGRES_PORT=5432
SHERLOCK_POSTGRES_SHM_SIZE=256mb
SHERLOCK_POSTGRES_PASSWORD_FILE=/etc/sherlock/secrets/postgres_password
