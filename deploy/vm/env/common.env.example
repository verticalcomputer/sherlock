# Copy to /etc/sherlock/common.env with mode 0600. Use the same URL for every
# control-plane process and for sherlock-admin. A hexadecimal password avoids
# URL-encoding ambiguity. The database is reachable only over VM loopback.
SHERLOCK_DATABASE_URL=postgres://sherlock:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/sherlock?sslmode=disable

# Start with local durable artifacts. API, worker, and investigator share this
# root, so keep them under the same service account in the initial VM layout.
SHERLOCK_ARTIFACT_BACKEND=local
SHERLOCK_ARTIFACT_ROOT=/var/lib/sherlock/artifacts
SHERLOCK_MODEL_AUDIT_ARTIFACT_ROOT=/var/lib/sherlock/artifacts
