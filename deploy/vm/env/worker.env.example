SHERLOCK_COLLECTION_EXECUTOR=remote
SHERLOCK_CLUSTER_ID=REPLACE_WITH_CLUSTER_ID
SHERLOCK_CLUSTER_NAME=REPLACE_WITH_CLUSTER_NAME
SHERLOCK_SOURCE_ID=REPLACE_WITH_SOURCE_ID
SHERLOCK_SOURCE_NAME=REPLACE_WITH_SOURCE_NAME
SHERLOCK_WORKER_ID=worker-vm-1
SHERLOCK_METRICS_ADDRESS=127.0.0.1:9091

# Source credentials belong on the remote collector, not this VM.
SHERLOCK_PROMETHEUS_URL=
SHERLOCK_PROMETHEUS_BEARER_TOKEN=
SHERLOCK_PROMETHEUS_USERNAME=
SHERLOCK_PROMETHEUS_PASSWORD=

# Automatic AI investigations stay fail-closed for the initial deployment.
SHERLOCK_AUTO_INVESTIGATION_ENABLED=false
SHERLOCK_AUTO_INVESTIGATION_MAX_DIAGNOSTIC_CALLS=0
