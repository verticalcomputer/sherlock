SHERLOCK_API_ADDRESS=127.0.0.1:8080

# Generate once with `openssl rand -base64 32`. Replacing this key invalidates
# authentication for API keys created with the previous hash key.
SHERLOCK_API_KEY_HASH_KEY=REPLACE_WITH_BASE64_32_BYTE_OR_LONGER_KEY

# Empty denies browser CORS. Set explicit HTTPS origins only when a browser
# application calls this API directly.
SHERLOCK_API_ALLOWED_ORIGINS=

# The private admin API is loopback-only and disabled until the dashboard is
# configured. The token must match admin-ui.env and must not be its bootstrap
# secret.
SHERLOCK_ADMIN_API_ENABLED=false
SHERLOCK_ADMIN_API_ADDRESS=127.0.0.1:8082
SHERLOCK_ADMIN_API_TOKEN=
# GP-10: enable both only after verified issuer/subject memberships exist and
# the paired dashboard gate can be tested with a signed-in operator.
SHERLOCK_ADMIN_HUMAN_SESSION_REQUIRED=false
SHERLOCK_ADMIN_HUMAN_AUTHORIZATION_REQUIRED=false

# Keep diagnostics disabled until reviewed pack, trust-root, inventory, and
# runner-version files are installed together.
SHERLOCK_COMMAND_PACK_FILE=
SHERLOCK_COMMAND_TRUST_ROOTS_FILE=
SHERLOCK_DIAGNOSTIC_INVENTORY_FILE=
SHERLOCK_RUNNER_VERSION=
