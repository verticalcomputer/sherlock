# Keep the unit disabled until these values are configured. Cloudflare Access
# protects the hostname and Sherlock independently verifies its application JWT.
SHERLOCK_ADMIN_ENABLED=false
SHERLOCK_ADMIN_ADDRESS=127.0.0.1:8081
SHERLOCK_ADMIN_API_URL=http://127.0.0.1:8082
SHERLOCK_ADMIN_API_TOKEN=REPLACE_WITH_ADMIN_API_SERVICE_TOKEN
SHERLOCK_ADMIN_CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://REPLACE_WITH_TEAM.cloudflareaccess.com
SHERLOCK_ADMIN_CLOUDFLARE_ACCESS_AUDIENCE=REPLACE_WITH_ADMIN_APPLICATION_AUD
# Enable alongside the API's GP-10 human-session and authorization flags.
SHERLOCK_ADMIN_HUMAN_AUTHORIZATION_REQUIRED=false
