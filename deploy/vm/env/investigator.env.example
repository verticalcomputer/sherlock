# Do not enable sherlock-investigator.service until every required provider,
# price, cluster-authority, and artifact setting has been reviewed.
SHERLOCK_INVESTIGATOR_ID=investigator-vm-1
SHERLOCK_MODEL_PROVIDER=azure-openai
SHERLOCK_AZURE_OPENAI_ENDPOINT=REPLACE_WITH_HTTPS_OPENAI_V1_ENDPOINT
SHERLOCK_AZURE_OPENAI_API_KEY=REPLACE_WITH_RUNTIME_SECRET
SHERLOCK_AZURE_OPENAI_DEPLOYMENT=REPLACE_WITH_DEPLOYMENT
SHERLOCK_MODEL_CONFIGURATION_ID=REPLACE_WITH_CONFIGURATION_ID
SHERLOCK_MODEL_ALLOWED_CLUSTERS=REPLACE_WITH_COMMA_SEPARATED_CLUSTER_IDS
SHERLOCK_MODEL_INPUT_MICROS_PER_MILLION_TOKENS=REPLACE_WITH_INTEGER
SHERLOCK_MODEL_OUTPUT_MICROS_PER_MILLION_TOKENS=REPLACE_WITH_INTEGER

# AI-triggered diagnostics require this second explicit authority. Empty keeps
# all model-generated diagnostic execution disabled.
SHERLOCK_DIAGNOSTIC_EXECUTION_CLUSTERS=
