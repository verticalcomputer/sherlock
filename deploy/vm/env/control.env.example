SHERLOCK_CONTROL_ADDRESS=127.0.0.1:8443

# Install production PKI with the private keys readable only by the Sherlock
# service account. Do not deploy the development PKI produced by the repository
# helper to a persistent environment.
SHERLOCK_CONTROL_CERT_FILE=/etc/sherlock/pki/control-server.crt
SHERLOCK_CONTROL_KEY_FILE=/etc/sherlock/pki/control-server.key
SHERLOCK_COLLECTOR_CA_FILE=/etc/sherlock/pki/collector-ca.crt
SHERLOCK_COLLECTOR_CA_KEY_FILE=/etc/sherlock/pki/collector-ca.key
SHERLOCK_COLLECTOR_IDENTITY_TTL=12h

# direct_mtls is the behavior-compatible default. For the Cloudflare Tunnel
# deployment, set cloudflare_access_service_token_pop explicitly and fill every
# setting below. The Service Token credential belongs only on the head node.
SHERLOCK_CONTROL_COLLECTOR_AUTH_MODE=direct_mtls
# SHERLOCK_CONTROL_COLLECTOR_AUTH_MODE=cloudflare_access_service_token_pop
# SHERLOCK_CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://REPLACE_WITH_TEAM.cloudflareaccess.com
# SHERLOCK_CLOUDFLARE_ACCESS_AUDIENCE=REPLACE_WITH_SINGLE_APPLICATION_AUD
# SHERLOCK_CONTROL_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# SHERLOCK_CONTROL_COLLECTOR_HOST=collector-control.vertical.computer
# SHERLOCK_CONTROL_ENROLLMENT_HOST=collector-enroll.vertical.computer

# Empty keeps diagnostic claim/result endpoints unregistered. Add only reviewed
# collector IDs after enrollment and authorization.
SHERLOCK_DIAGNOSTIC_EXECUTION_COLLECTORS=
